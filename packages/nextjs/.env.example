# NextJS env. Copy to .env for local dev; set in Vercel for production.

NEXT_PUBLIC_ALCHEMY_API_KEY=
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=

# Obec — server-only (keep out of NEXT_PUBLIC_*)

# Private key for the CCIP-Read gateway signer. ObecResolver verifies that
# responses are signed by this key.
GATEWAY_PRIVATE_KEY=

# ObecResolver address on Sepolia (used in the EIP-191 signature digest).
RESOLVER_ADDRESS=

# ObecRegistry address on Base Sepolia (queried by the gateway).
REGISTRY_ADDRESS=

# Optional — falls back to https://base-sepolia.g.alchemy.com/v2/${NEXT_PUBLIC_ALCHEMY_API_KEY}
BASE_SEPOLIA_RPC_URL=

# Public — exposed to the client
NEXT_PUBLIC_PROTOCOL_ROOT=obec.eth
